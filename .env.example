# ─── LLM provider ───
# "qwen" (Qwen Cloud / DashScope) or "openai-compatible" (OpenAI, Gemini, Groq, a local server...)
CYGNE_LLM_PROVIDER=qwen
QWEN_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CYGNE_MAIN_MODEL=qwen-max
CYGNE_SUMMARY_MODEL=qwen-plus

# With CYGNE_LLM_PROVIDER=openai-compatible, e.g. Gemini:
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CYGNE_MAIN_MODEL=gemini-2.5-flash-lite
# CYGNE_SUMMARY_MODEL=gemini-2.5-flash-lite

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your-botfather-token
# Operator chat that receives quote-approval prompts (human-in-the-loop)
TELEGRAM_OPERATOR_CHAT_ID=your-operator-chat-id

# ─── Google Calendar (optional — falls back to internal scheduling if unset) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ─── Email invitation (optional — skipped if unset; Gmail needs an app password) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CYGNE_AGENCY_NAME=Cygne Marketing
CYGNE_ORGANIZER_EMAIL=your-gmail@gmail.com

# ─── Dashboard (lists prospects' contact details; stays closed until a password is set) ───
CYGNE_DASHBOARD_USER=operator
CYGNE_DASHBOARD_PASSWORD=

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://cygne:cygne@localhost:5432/cygne

# ─── App ───
CYGNE_ENV=development
CYGNE_LOG_LEVEL=INFO
SUMMARY_THRESHOLD=50
# The agency's smallest monthly engagement; lead budgets are scored against it
CYGNE_MIN_MONTHLY_BUDGET=1000
# Business timezone for scheduling (IANA name, e.g. Africa/Cairo, Europe/London)
CYGNE_TIMEZONE=UTC
